# Plantilla de variables de entorno de ZANTIA — NUNCA completar valores
# reales aquí. Copiar a .env (ya gitignored) y completar ahí.

# API key de Anthropic, solo necesaria si se activa core/brain.py:AnthropicBrain
# (no usada por la suite de tests, que corre con FakeBrain).
ANTHROPIC_API_KEY=

# Ruta del archivo SQLite de persistencia del ConversationState.
# Si se omite, el código usa ":memory:" (sin persistencia entre procesos).
ZANTIA_DB_PATH=

# Integración real con hrmm-backend (domains/health/hrmm_appointment_service.py)
# Solo necesarias si se activa HrmmAppointmentService — no usadas por
# la suite de tests, que corre con FakeHttpClient (sin red real).

# staging|production — nunca apunta a producción por defecto; ver
# recado de la fase de integración hrmm-backend (no existe staging
# real documentado para hrmm-backend a la fecha de esa investigación).
HRMM_BACKEND_ENV=

# URL base de la API de agenda de hrmm-backend.
HRMM_BACKEND_URL=

# Mismo valor que BACKEND_TRUSTED_SECRET del lado de hrmm-backend —
# el usuario copia el valor real directamente desde EasyPanel, nunca
# se pasa por chat ni se hardcodea.
HRMM_BACKEND_SECRET=
