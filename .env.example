# Plantilla de variables de entorno de ZANTIA — NUNCA completar valores
# reales aquí. Copiar a .env (ya gitignored) y completar ahí.

# API key de Anthropic, solo necesaria si se activa core/brain.py:AnthropicBrain
# (no usada por la suite de tests, que corre con FakeBrain).
ANTHROPIC_API_KEY=

# Ruta del archivo SQLite de persistencia del ConversationState (leída
# por core/agent_contract.py:build_orchestrator, recado 021 — antes era
# una brecha de wiring: la variable existía acá pero nunca se conectaba).
# Si se omite, el código usa ":memory:" (sin persistencia entre
# procesos) — NO es silencioso: cada conversación nueva deja un
# logger.warning explícito en los logs avisando que no está persistiendo
# de verdad. Configurarla siempre antes de desplegar cualquier canal en
# producción, sin excepción.
ZANTIA_DB_PATH=

# Ruta del archivo SQLite de la tabla identidad_canal — identidad del
# CANAL (ej. número de WhatsApp) verificada, persistente ENTRE
# conversaciones y reinicios del proceso (recado 014,
# domains/health/identity_store.py). Deliberadamente SEPARADA de
# ZANTIA_DB_PATH: ese store es por Activity/conversación (nace y muere
# con ella, ver core/agent_contract.py), este vive mientras el teléfono
# siga siendo válido. Si se omite, usa ":memory:" (sin persistencia
# entre reinicios — nunca reconoce a un paciente que vuelve).
ZANTIA_IDENTIDAD_DB_PATH=

# Ruta del archivo SQLite del EventLog (auditoría append-only: transiciones
# de estado, tools invocadas, decisiones de guardrail — recado 037, cierra
# R-11 para EventLog). Leída por core/agent_contract.py:build_orchestrator,
# mismo patrón exacto que ZANTIA_DB_PATH. Si se omite, usa ":memory:"
# (SQLite en memoria, nunca objetos Python puros — mismo esquema, sin
# archivo real) — nunca en silencio: cada conversación nueva deja un
# logger.warning explícito avisando que la auditoría no sobrevive un
# reinicio del proceso. Configurarla siempre antes de desplegar cualquier
# canal en producción — sin esto, no hay forma de auditar qué decidió o
# propuso el sistema (incluyendo un futuro Brain basado en LLM) si el
# proceso se reinicia.
ZANTIA_EVENTS_DB_PATH=

# Ruta del archivo SQLite de ConversationMemory (historial reciente de
# turnos que ve el Brain para redactar con continuidad — recado 037,
# cierra R-11 para ConversationMemory). Mismo patrón que las anteriores.
# Sigue siendo una VENTANA acotada en la lectura (get_recent devuelve como
# máximo memory_window turnos, igual que antes) — la tabla en sí conserva
# el historial completo, sin política de retención definida todavía
# (mismo estado PENDIENTE que ConversationState, ver .ai/DATA_MODEL.md).
# Si se omite, usa ":memory:" con el mismo logger.warning explícito.
ZANTIA_MEMORY_DB_PATH=

# Integración real con hrmm-backend (domains/health/hrmm_appointment_service.py)
# Solo necesarias si se activa HrmmAppointmentService — no usadas por
# la suite de tests, que corre con FakeHttpClient (sin red real).

# staging|production — nunca apunta a producción por defecto; ver
# recado de la fase de integración hrmm-backend (no existe staging
# real documentado para hrmm-backend a la fecha de esa investigación).
# IMPORTANTE (hallazgo real, recado 025): dejar esta línea presente
# pero VACÍA (HRMM_BACKEND_ENV=) NO es lo mismo que omitirla del todo —
# build_appointment_service() la lee como '' (string vacío), NO cae al
# default seguro "mock", y el proceso falla al arrancar con
# HealthConfigError("HRMM_BACKEND_ENV='' no es un valor reconocido").
# Si no vas a usar hrmm-backend real, BORRÁ la línea completa (o dejala
# comentada) en vez de dejar el signo "=" solo.
HRMM_BACKEND_ENV=

# URL base de la API de agenda de hrmm-backend.
HRMM_BACKEND_URL=

# Mismo valor que BACKEND_TRUSTED_SECRET del lado de hrmm-backend —
# el usuario copia el valor real directamente desde EasyPanel, nunca
# se pasa por chat ni se hardcodea.
HRMM_BACKEND_SECRET=

# Canal real ChatwootChannel (channels/chatwoot_channel.py, decisión
# D-5) — OPCIONALES desde recado 024 (decisión D-8): si se omiten,
# service/app.py arranca igual con Chatwoot deshabilitado (POST
# /webhook/chatwoot responde 503 explícito si se invoca). Configurarlas
# solo si de verdad vas a usar este canal. CHATWOOT_URL/ACCOUNT_ID deben
# apuntar al inbox de PRUEBA, nunca al de producción de HRMM (recado 012).

# URL base de la instancia de Chatwoot (ej. https://chatwoot.midominio.com).
CHATWOOT_URL=

# ID numérico de la cuenta de Chatwoot (visible en la URL del panel).
CHATWOOT_ACCOUNT_ID=

# Access token de la API de Chatwoot (perfil del agente/bot en Chatwoot
# -> Profile Settings -> Access Token) — nunca se pasa por chat ni se
# hardcodea, el usuario lo copia directamente desde Chatwoot.
CHATWOOT_API_TOKEN=

# Canal real TelegramChannel (channels/telegram_channel.py, recado 022,
# decisión D-7: webhook, no polling). Token del bot, generado por
# @BotFather (Telegram) al crear el bot — nunca se pasa por chat ni se
# hardcodea. A diferencia de Chatwoot, no hace falta ninguna otra
# variable estructural (URL/account id): la Bot API de Telegram es
# siempre la misma URL pública (api.telegram.org), y el chat_id llega
# solo en cada Update entrante.
TELEGRAM_BOT_TOKEN=

# Secreto propio (lo generás vos, ej. con `openssl rand -hex 32` — no lo
# da Telegram) para verificar que las peticiones a /webhook/telegram
# realmente vienen de Telegram (recado 023, cierra R-23) — OBLIGATORIA
# para que service/app.py arranque si vas a usar Telegram (falla claro
# si falta) — a diferencia de Chatwoot (opcional desde D-8), este canal
# siempre necesita poder validar el origen del webhook. Debe pasarse
# como parámetro `secret_token` al registrar el webhook (paso manual,
# fuera de este código):
# https://api.telegram.org/bot<TOKEN>/setWebhook?url=<URL_PUBLICA_DE_ZANTIA>/webhook/telegram&secret_token=<ESTE_MISMO_VALOR>
# Telegram reenvía ese mismo valor en cada petición como header
# X-Telegram-Bot-Api-Secret-Token — TelegramChannel.verificar_secreto_webhook
# lo compara contra esta variable antes de procesar cualquier payload.
TELEGRAM_WEBHOOK_SECRET=
