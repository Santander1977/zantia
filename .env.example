# Plantilla de variables de entorno de ZANTIA — NUNCA completar valores
# reales aquí. Copiar a .env (ya gitignored) y completar ahí.

# API key de Anthropic, solo necesaria si se activa core/brain.py:AnthropicBrain
# (no usada por la suite de tests, que corre con FakeBrain).
ANTHROPIC_API_KEY=

# Ruta del archivo SQLite de persistencia del ConversationState (leída
# por core/agent_contract.py:build_orchestrator, recado 021 — antes era
# una brecha de wiring: la variable existía acá pero nunca se conectaba).
# Si se omite, el código usa ":memory:" (sin persistencia entre
# procesos) — NO es silencioso: cada conversación nueva deja un
# logger.warning explícito en los logs avisando que no está persistiendo
# de verdad. Configurarla siempre antes de desplegar cualquier canal en
# producción, sin excepción.
ZANTIA_DB_PATH=

# Ruta del archivo SQLite de la tabla identidad_canal — identidad del
# CANAL (ej. número de WhatsApp) verificada, persistente ENTRE
# conversaciones y reinicios del proceso (recado 014,
# domains/health/identity_store.py). Deliberadamente SEPARADA de
# ZANTIA_DB_PATH: ese store es por Activity/conversación (nace y muere
# con ella, ver core/agent_contract.py), este vive mientras el teléfono
# siga siendo válido. Si se omite, usa ":memory:" (sin persistencia
# entre reinicios — nunca reconoce a un paciente que vuelve).
ZANTIA_IDENTIDAD_DB_PATH=

# Integración real con hrmm-backend (domains/health/hrmm_appointment_service.py)
# Solo necesarias si se activa HrmmAppointmentService — no usadas por
# la suite de tests, que corre con FakeHttpClient (sin red real).

# staging|production — nunca apunta a producción por defecto; ver
# recado de la fase de integración hrmm-backend (no existe staging
# real documentado para hrmm-backend a la fecha de esa investigación).
HRMM_BACKEND_ENV=

# URL base de la API de agenda de hrmm-backend.
HRMM_BACKEND_URL=

# Mismo valor que BACKEND_TRUSTED_SECRET del lado de hrmm-backend —
# el usuario copia el valor real directamente desde EasyPanel, nunca
# se pasa por chat ni se hardcodea.
HRMM_BACKEND_SECRET=

# Canal real ChatwootChannel (channels/chatwoot_channel.py, decisión
# D-5) — obligatorias para que service/app.py arranque (falla claro si
# faltan, ver .ai/RISKS.md R-16). CHATWOOT_URL/ACCOUNT_ID deben apuntar
# al inbox de PRUEBA, nunca al de producción de HRMM (recado 012).

# URL base de la instancia de Chatwoot (ej. https://chatwoot.midominio.com).
CHATWOOT_URL=

# ID numérico de la cuenta de Chatwoot (visible en la URL del panel).
CHATWOOT_ACCOUNT_ID=

# Access token de la API de Chatwoot (perfil del agente/bot en Chatwoot
# -> Profile Settings -> Access Token) — nunca se pasa por chat ni se
# hardcodea, el usuario lo copia directamente desde Chatwoot.
CHATWOOT_API_TOKEN=
